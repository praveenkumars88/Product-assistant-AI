# Copy this file to .env.local and fill in real values.

# From your Meta App > Settings > Basic
META_APP_ID=
META_APP_SECRET=

# Your public tunnel URL for this run (ngrok/cloudflared), no trailing slash
# e.g. https://abcd-1234.ngrok-free.app
BASE_URL=

# Any long random string, used to sign the session cookie
SESSION_SECRET=change-me-to-a-long-random-string
